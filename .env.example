# PlagIQ configuration template. Copy values into Railway → Service → Variables.
# NEVER put real secrets in this file or in GitHub.

# ---- Website service ----
# Exact public HTTPS address of the site, no trailing slash.
PUBLIC_ORIGIN=https://your-staging-domain.up.railway.app
# Optional private-pilot login (both required; password at least 16 characters).
PRIVATE_PILOT_USER=
PRIVATE_PILOT_PASSWORD=
# 1 on Railway (the app is only reachable through Railway's proxy); 0 elsewhere.
TRUSTED_PROXY_HOPS=1
# Documents processed at the same time (1-8). Extra requests get a "busy, try again" message.
SCAN_CONCURRENCY=2
# Private engine (leave empty to disable the corpus option; other modes keep working).
ENGINE_URL=
ENGINE_API_KEY=
ENGINE_TIMEOUT=120
# Planned prices shown on the site (display only; no payments). Leave empty for the defaults.
# PRICING_TIERS=[{"id":"free","max_words":1000,"price_uzs":0},{"id":"researcher","max_words":3500,"price_uzs":15000},{"id":"extended","max_words":15000,"price_uzs":45000}]
# OpenAlex API key (free registration). Needed for reliable academic discovery since OpenAlex's 2026 pricing change.
OPENALEX_API_KEY=

# ---- Engine service (separate Railway service, no public domain) ----
# ENGINE_API_KEY=<same value as on the website>
# CORPUS_DB=/data/corpus.sqlite3
# CORPUS_MAX_SOURCES=1000   (measured: ~171 MB, ~0.1 s per search; see evaluation/BENCHMARKS.md)
# PORT=8000
# Automatic OpenAlex import (open licences only; PDFs deleted after indexing):
# AUTO_IMPORT=uz              languages: uz, ru, en (comma-separated); empty = off
# AUTO_IMPORT_BATCH=300       new works per language per run
# AUTO_IMPORT_HOURS=24        hours between runs (1-720)
# AUTO_IMPORT_MAX_COST=0.20   OpenAlex spending cap per language per run, USD
# AUTO_IMPORT_OPENALEX_PDF=   1 = use OpenAlex's PDF copy (~$0.01) when the journal's PDF is unreachable
# UNPAYWALL_EMAIL=            optional: cross-check licences with Unpaywall
# Wikipedia (CC BY-SA 4.0) from official Wikimedia dumps:
# AUTO_IMPORT_WIKIPEDIA=uz    languages: uz, ru, en; empty = off
# WIKIPEDIA_BATCH=2000        new articles per language per run
# WIKIPEDIA_MIN_WORDS=300     skip shorter stub articles
# For the owner-run collection tools (oa_import.py) on the engine:
# OPENALEX_API_KEY=<your key>
# CORE_API_KEY=<your key>
